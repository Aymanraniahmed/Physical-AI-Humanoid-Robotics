# Google Gemini API Key (https://makersuite.google.com/app/apikey se lena hai)
GEMINI_API_KEY=your-gemini-api-key-here

# Qdrant Settings
# Option 1: Local Docker (docker-compose up karke use karo)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Local ke liye zaroorat nahi

# Option 2: Qdrant Cloud (https://cloud.qdrant.io/ se cluster banao)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# Embedding Model Settings
EMBEDDING_MODEL=models/embedding-001  # Gemini embedding model
EMBEDDING_DIMENSION=768  # Gemini embedding-001 ki dimension

# Chat Model Settings
CHAT_MODEL=gemini-pro  # Gemini Pro model (FREE hai!)

# Chunking Settings
CHUNK_SIZE=1000  # Har chunk mein kitne tokens
CHUNK_OVERLAP=200  # Chunks ke beech overlap

# Database Settings (Optional - agar chat history save karni ho)
DATABASE_URL=postgresql://user:password@localhost:5432/ragchatbot

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# CORS Settings (frontend ka URL yahan daalo)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000
